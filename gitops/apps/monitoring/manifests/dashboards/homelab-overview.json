{
 "uid": "homelab-overview",
 "title": "Homelab: обзор",
 "tags": [
  "homelab"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "graphTooltip": 1,
 "time": {
  "from": "now-6h",
